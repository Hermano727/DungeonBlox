{
  "name": "DungeonBlox",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$path": "src/shared",
      "Packages": {
        "$path": "Packages"
      }
    },
    "ServerScriptService": {
      "CanPlayerAct": {
        "$className": "BindableFunction"
      },
      "GetPlayerState": {
        "$className": "BindableFunction"
      },
      "TransitionPlayerState": {
        "$className": "BindableFunction"
      },
      "$path": "src/server"
    },
    "StarterPlayer": {
      "StarterCharacterScripts": {
        "$path": "src/characterscripts"
      },
      "StarterPlayerScripts": {
        "$path": "src/client"
      },
      "$properties": {
        "AvatarJointUpgrade": "Enabled",
        "CameraMaxZoomDistance": 128.0,
        "CharacterBreakJointsOnDeath": false,
        "CharacterJumpHeight": 40.128562927246094,
        "LoadCharacterAppearance": false
      }
    }
  },
  "syncbackRules": {
    "ignoreTrees": [
      "Workspace",
      "Lighting",
      "MaterialService",
      "SoundService",
      "StarterGui",
      "StarterPack",
      "ServerStorage",
      "Teams",
      "Players",
      "TextChatService"
    ],
    "ignorePaths": [
      "Packages",
      ".git",
      "assets",
      "roblox"
    ],
    "ignoreProperties": {
      "BasePart": [
        "Position",
        "Orientation",
        "CFrame"
      ],
      "Instance": [
        "Archivable"
      ]
    },
    "syncCurrentCamera": false
  }
}