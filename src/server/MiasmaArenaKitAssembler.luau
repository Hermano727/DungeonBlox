--[[
	MiasmaArenaKitAssembler -- EDIT-TIME TOOL. Never required by the running game.

	Dresses the Miasma arena with the Blender modular kit
	(assets/builds/MiasmaBossRoom/kit_v01, one FBX per group):

		WallsGates  wall bays, pilasters, corner shafts, altar recess arches, sluice pieces, gates
		Water       channel runs, bend nodes, bridges, grates, basin edging and inlets
		Floor       paving, damaged paving, perimeter gutters, combat-platform setts and kerb
		Ceiling     slabs, rib arches, wall-top arches, fractured shaft rim, shaft walls
		Landmarks   entrance portal and corridor, altar alcoves and fonts, boss ring, drain crown
		Dressing    bones, chains, rubble, leaks, puddles, slime

	The kit is VISUAL ONLY. Every layout primitive keeps its collision: the ones a group replaces
	are only made invisible (Kit.Hides), so movement, raycasts and gameplay parts behave exactly
	as before. Gameplay parts (channel Sludge/Water, basin liquid, CleanseWater, RuneRing, safe
	pads, anchors) are never touched.

	1. Import each FBX (File > Import 3D, Scale Unit Stud, No Rig, Merge Meshes OFF), then
	   register it (moves its meshes into ServerStorage.MiasmaArenaKit.<Group>):

		local SSS = game:GetService("ServerScriptService")
		local Kit = loadstring(SSS.MiasmaArenaKitAssembler.Source)()
		print(Kit.Register({ import = workspace.MiasmaKit_WallsGates_v01, group = "WallsGates" }))

	2. Dress the template arena (all registered groups, or pass groups = { "Floor" }):

		print(Kit.Dress({ realm = workspace:FindFirstChild("DungeonRealmTemplate", true) }))

	Placements come from SSS/MiasmaArenaKitPlacements (generated by the kit's placements.py).
	Re-dressing replaces a group; the old folder goes to ServerStorage.MiasmaArenaBackups.ArtKitHistory.
	Undo: Kit.Undress({ realm = ..., groups = { "Floor" } }).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Kit = {}

Kit.FolderName = "MiasmaArtKit"        -- inside T1DungeonTemplate
Kit.StorageName = "MiasmaArenaKit"     -- ServerStorage
Kit.Groups = { "WallsGates", "Water", "Floor", "Ceiling", "Landmarks", "Dressing" }

-- Layout primitives each group replaces visually. Paths are under MiasmaArenaLayout; a segment
-- "*" matches any name, "Prefix*" matches names starting with Prefix.
Kit.Hides = {
	WallsGates = { "Walls/Pilaster", "Walls/BaseCourse", "Walls/ArchStone", "Walls/Buttress" },
	Water = {
		"Channels/MiasmaChannel_*/OuterBed", "Channels/MiasmaChannel_*/InnerBed",
		"Channels/MiasmaChannel_*/OuterLip", "Channels/MiasmaChannel_*/InnerLip",
		"Channels/MiasmaChannel_*/OuterGrate", "Channels/MiasmaChannel_*/InnerGrate",
		"Channels/MiasmaCenterBasin/Rim", "Channels/MiasmaCenterBasin/DrainGrate",
	},
	Floor = { "Floor/RoomFloor", "Floor/CombatPlatform", "Floor/PlatformEdge" },
	Ceiling = {
		"Ceiling/CeilingNorth", "Ceiling/CeilingSouth", "Ceiling/CeilingWest", "Ceiling/CeilingEast",
		"Ceiling/Rib", "Ceiling/ShaftRimBeam", "Ceiling/Fracture", "Ceiling/ShaftWall",
	},
	Landmarks = {
		"Altars/CleanseAltar_*/Plinth", "Altars/CleanseAltar_*/Pedestal", "Altars/CleanseAltar_*/Basin",
		"Recesses/AltarRecess_*/SideWall", "Recesses/AltarRecess_*/BackWall", "Recesses/AltarRecess_*/Roof",
		"Recesses/AltarRecess_*/RecessFloor",
	},
	Dressing = {},
}

-- Module-local light points the kit meshes cannot carry themselves.
local FIRE = Color3.fromRGB(255, 170, 90)
Kit.Lights = {
	EntranceArch_16 = {
		{ position = Vector3.new(-14.4, 11.3, 10.6), color = FIRE, range = 22, brightness = 1.4, fire = true },
		{ position = Vector3.new(14.4, 11.3, 10.6), color = FIRE, range = 22, brightness = 1.4, fire = true },
	},
}

local REF_BACK = Vector3.new(0, 0, -5)
local REF_UP = Vector3.new(0, 5, 0)

-------------------------------------------------------------------------------------------------

local function freshRequire(moduleScript)
	local copy = moduleScript:Clone()
	copy.Name = moduleScript.Name .. "_KitCopy"
	copy.Parent = moduleScript.Parent
	local ok, result = pcall(require, copy)
	copy:Destroy()
	if not ok then error(result, 2) end
	return result
end

local function arenaOf(realm)
	local room = realm:FindFirstChild("T1 BOSS ROOM")
	local miasma = room and room:FindFirstChild("miasma")
	local arena = miasma and miasma:FindFirstChild("T1DungeonTemplate")
	assert(arena, "no <realm>/T1 BOSS ROOM/miasma/T1DungeonTemplate")
	return arena
end

local function history()
	local backups = ServerStorage:FindFirstChild("MiasmaArenaBackups") or Instance.new("Folder")
	backups.Name = "MiasmaArenaBackups"
	backups.Parent = ServerStorage
	local folder = backups:FindFirstChild("ArtKitHistory") or Instance.new("Folder")
	folder.Name = "ArtKitHistory"
	folder.Parent = backups
	return folder
end

local function retire(instance)
	instance.Name = instance.Name .. "_" .. os.date("!%Y%m%d_%H%M%S")
	instance.Parent = history()
	return instance.Name
end

local function findPart(model, name)
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and item.Name == name then return item end
	end
	return nil
end

-- Moves an import so its REF markers sit at the kit origin (identity frame), fixing uniform scale.
local function alignToOrigin(model, report)
	local function frameOf()
		local origin, back, up = findPart(model, "REF_Origin"), findPart(model, "REF_Back"), findPart(model, "REF_Up")
		assert(origin and back and up, model.Name .. ": REF markers missing (Merge Meshes on?)")
		local toBack, toUp = back.Position - origin.Position, up.Position - origin.Position
		local scale = toBack.Magnitude / REF_BACK.Magnitude
		assert(math.abs(toUp.Magnitude / REF_UP.Magnitude - scale) < .01 * scale, model.Name .. ": non-uniform import scale")
		assert(math.abs(toBack.Unit:Dot(toUp.Unit)) < .01, model.Name .. ": REF axes not perpendicular")
		return CFrame.lookAt(origin.Position, origin.Position + toBack, toUp.Unit), scale
	end
	local frame, scale = frameOf()
	if math.abs(scale - 1) > .002 then
		model:ScaleTo(model:GetScale() / scale)
		table.insert(report, ("%s imported at %.4fx; rescaled to studs"):format(model.Name, scale))
		frame = frameOf()
	end
	local delta = frame:Inverse()
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then part.CFrame = delta * part.CFrame end
	end
end

-------------------------------------------------------------------------------------------------
-- Register

function Kit.Register(options)
	local import = assert(options.import, "import (the imported kit model) required")
	local group = assert(options.group, "group required")
	assert(table.find(Kit.Groups, group), "unknown group " .. tostring(group))
	local report = {}
	alignToOrigin(import, report)

	local storage = ServerStorage:FindFirstChild(Kit.StorageName) or Instance.new("Folder")
	storage.Name = Kit.StorageName
	storage.Parent = ServerStorage
	local groupFolder = storage:FindFirstChild(group) or Instance.new("Folder")
	groupFolder.Name = group
	groupFolder.Parent = storage

	local modules, untextured = {}, {}
	for _, part in ipairs(import:GetDescendants()) do
		if part:IsA("BasePart") and not string.match(part.Name, "^REF_") then
			local moduleName = string.match(part.Name, "^(.-)__") or part.Name
			local model = modules[moduleName]
			if not model then
				model = Instance.new("Model")
				model.Name = moduleName
				model:SetAttribute("KitGroup", group)
				modules[moduleName] = model
			end
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = not (string.find(part.Name, "__Residue") or string.find(part.Name, "__Slime"))
			pcall(function() part.CollisionFidelity = Enum.CollisionFidelity.Box end)
			if not part:FindFirstChildOfClass("SurfaceAppearance") and not (part:IsA("MeshPart") and part.TextureID ~= "") then
				table.insert(untextured, part.Name)
			end
			part.Parent = model
		end
	end
	local count = 0
	for name, model in pairs(modules) do
		local old = groupFolder:FindFirstChild(name)
		if old then retire(old) end
		model.WorldPivot = CFrame.identity
		model.Parent = groupFolder
		count += 1
	end
	import:Destroy()
	table.insert(report, ("registered %d %s modules in ServerStorage.%s.%s"):format(count, group, Kit.StorageName, group))
	if #untextured > 0 then
		table.insert(report, "WARNING untextured: " .. table.concat(untextured, ", "))
	end
	return table.concat(report, "\n")
end

-------------------------------------------------------------------------------------------------
-- Hides

local function segmentMatches(pattern, name)
	if pattern == "*" then return true end
	if string.sub(pattern, -1) == "*" then
		local prefix = string.sub(pattern, 1, -2)
		return string.sub(name, 1, #prefix) == prefix
	end
	return pattern == name
end

local function matchPath(root, path)
	local nodes = { root }
	for _, segment in ipairs(string.split(path, "/")) do
		local nextNodes = {}
		for _, node in ipairs(nodes) do
			for _, child in ipairs(node:GetChildren()) do
				if segmentMatches(segment, child.Name) then table.insert(nextNodes, child) end
			end
		end
		nodes = nextNodes
	end
	return nodes
end

local function hideGroup(arena, group)
	local layout = arena:FindFirstChild("MiasmaArenaLayout")
	if not layout then return 0 end
	local hidden = 0
	for _, path in ipairs(Kit.Hides[group] or {}) do
		for _, part in ipairs(matchPath(layout, path)) do
			if part:IsA("BasePart") then
				if part:GetAttribute("ArtKitHidden") == nil then
					part:SetAttribute("ArtKitOriginalTransparency", part.Transparency)
					part:SetAttribute("ArtKitOriginalShadow", part.CastShadow)
				end
				part:SetAttribute("ArtKitHidden", group)
				part.Transparency = 1
				part.CastShadow = false
				for _, light in ipairs(part:GetChildren()) do
					if light:IsA("Light") then light.Enabled = false end
				end
				hidden += 1
			end
		end
	end
	return hidden
end

local function unhideGroup(arena, group)
	local layout = arena:FindFirstChild("MiasmaArenaLayout")
	if not layout then return 0 end
	local restored = 0
	for _, part in ipairs(layout:GetDescendants()) do
		if part:IsA("BasePart") and part:GetAttribute("ArtKitHidden") == group then
			part.Transparency = part:GetAttribute("ArtKitOriginalTransparency") or 0
			part.CastShadow = part:GetAttribute("ArtKitOriginalShadow") ~= false
			for _, light in ipairs(part:GetChildren()) do
				if light:IsA("Light") then light.Enabled = true end
			end
			part:SetAttribute("ArtKitHidden", nil)
			part:SetAttribute("ArtKitOriginalTransparency", nil)
			part:SetAttribute("ArtKitOriginalShadow", nil)
			restored += 1
		end
	end
	return restored
end

-- Idempotent; MiasmaArenaLayoutBuilder calls this after a rebuild.
function Kit.ReapplyHides(arena)
	local folder = arena:FindFirstChild(Kit.FolderName)
	if not folder then return "kit: nothing dressed" end
	local total = 0
	for _, group in ipairs(Kit.Groups) do
		if folder:FindFirstChild(group) then total += hideGroup(arena, group) end
	end
	return ("kit: %d layout parts hidden (collision kept)"):format(total)
end

-------------------------------------------------------------------------------------------------
-- Dress

local function scaleInPlace(model, scale)
	-- Only valid while the model sits at the identity pivot with axis-aligned parts (kit modules do).
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local rotation = part.CFrame.Rotation
			part.Size = part.Size * scale
			part.CFrame = CFrame.new(part.Position * scale) * rotation
		end
	end
end

local function addLights(model, name)
	for _, spec in ipairs(Kit.Lights[name] or {}) do
		local holder = Instance.new("Attachment")
		holder.Name = "KitLight"
		local host = model:FindFirstChildWhichIsA("BasePart")
		if not host then return end
		holder.Parent = host -- parent FIRST: WorldPosition on an unparented attachment is taken as local
		holder.WorldPosition = model:GetPivot():PointToWorldSpace(spec.position)
		local light = Instance.new("PointLight")
		light.Color = spec.color
		light.Range = spec.range
		light.Brightness = spec.brightness
		light.Shadows = false
		light.Parent = holder
		if spec.fire then
			local fire = Instance.new("ParticleEmitter")
			fire.Texture = "rbxasset://textures/particles/fire_main.dds"
			fire.Color = ColorSequence.new(Color3.fromRGB(255, 190, 110), Color3.fromRGB(200, 70, 30))
			fire.LightEmission = 1
			fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, .9), NumberSequenceKeypoint.new(1, .2) })
			fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, .2), NumberSequenceKeypoint.new(1, 1) })
			fire.Lifetime = NumberRange.new(.4, .8)
			fire.Rate = 18
			fire.Speed = NumberRange.new(2, 3.5)
			fire.SpreadAngle = Vector2.new(8, 8)
			fire.EmissionDirection = Enum.NormalId.Top
			fire.Parent = holder
		end
	end
end

local function checkLayout(placements)
	local Layout = require(ReplicatedStorage:WaitForChild("MiasmaArenaLayout"))
	for key, value in pairs(placements.Layout) do
		local live = Layout[key]
		assert(live == value, ("placements were generated for %s = %s but MiasmaArenaLayout has %s; regenerate kit_v01/placements.py"):format(key, tostring(value), tostring(live)))
	end
end

function Kit.Dress(options)
	local realm = assert(options.realm, "realm required")
	local arena = arenaOf(realm)
	local placements = freshRequire(ServerScriptService:WaitForChild("MiasmaArenaKitPlacements"))
	checkLayout(placements)
	local Resolver = freshRequire(ServerScriptService:WaitForChild("MiasmaArenaResolver"))
	local origin = Resolver.new(realm).Origin
	local storage = ServerStorage:FindFirstChild(Kit.StorageName)
	local report = {}

	local root = arena:FindFirstChild(Kit.FolderName) or Instance.new("Folder")
	root.Name = Kit.FolderName
	root.Parent = arena

	for _, group in ipairs(options.groups or Kit.Groups) do
		local source = storage and storage:FindFirstChild(group)
		local rows = placements.Groups[group]
		if not source then
			table.insert(report, group .. ": not registered, skipped")
		elseif not rows then
			table.insert(report, group .. ": no placements, skipped")
		else
			local old = root:FindFirstChild(group)
			if old then
				unhideGroup(arena, group)
				retire(old)
			end
			local folder = Instance.new("Folder")
			folder.Name = group
			local placed, missing = 0, {}
			for _, row in ipairs(rows) do
				local module = source:FindFirstChild(row[1])
				if module then
					local copy = module:Clone()
					if row[14] then scaleInPlace(copy, Vector3.new(row[14], row[15], row[16])) end
					copy:PivotTo(origin * CFrame.new(row[2], row[3], row[4], row[5], row[6], row[7], row[8], row[9], row[10], row[11], row[12], row[13]))
					addLights(copy, row[1])
					copy.Parent = folder
					placed += 1
				else
					missing[row[1]] = true
				end
			end
			folder.Parent = root
			local missingNames = {}
			for name in pairs(missing) do table.insert(missingNames, name) end
			table.insert(report, ("%s: placed %d, hid %d layout parts%s"):format(group, placed, hideGroup(arena, group),
				#missingNames > 0 and (", MISSING modules: " .. table.concat(missingNames, ", ")) or ""))
		end
	end
	return table.concat(report, "\n")
end

function Kit.Undress(options)
	local arena = arenaOf(assert(options.realm, "realm required"))
	local root = arena:FindFirstChild(Kit.FolderName)
	local report = {}
	for _, group in ipairs(options.groups or Kit.Groups) do
		local folder = root and root:FindFirstChild(group)
		local restored = unhideGroup(arena, group)
		if folder then
			table.insert(report, ("%s: moved to ArtKitHistory/%s, restored %d layout parts"):format(group, retire(folder), restored))
		end
	end
	return table.concat(report, "\n")
end

return Kit
